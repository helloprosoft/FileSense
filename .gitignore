# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
env/

# PyInstaller/build output
/build/
/dist/
/installer/*.exe
/installer/*.zip
*.spec.bak

# Local secrets and signing material
/developer_keys/
**/developer_keys/
*.pem
*.pfx
*.p12
*.key
.env
.env.*
!.env.example

# Logs, temporary files, and OS metadata
*.log
*.tmp
*.bak
Thumbs.db
Desktop.ini
.DS_Store
